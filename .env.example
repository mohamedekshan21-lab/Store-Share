# =============================================================================
# Store-Share Distributed Storage Network Configuration
# Template Environment File (.env.example) - Placeholders Only
# NEVER COMMIT REAL PRIVATE KEYS, JWT SECRETS, OR PASSWORDS TO SOURCE CONTROL
# =============================================================================

# Coordinator Daemon Binding & Host
COORDINATOR_HOST=127.0.0.1
COORDINATOR_PORT=9000
COORDINATOR_ENV=development
LOG_LEVEL=INFO

# Persistent Database File Path (SQLite)
COORDINATOR_DB_PATH=coordinator_metadata.db

# Machine Authentication Token (Used by storage node daemons for heartbeats and registration)
COORDINATOR_AUTH_TOKEN=generate-a-random-32-byte-hex-string-for-machine-daemons

# Administrative Machine Token (Optional separate token for infrastructure scripts)
COORDINATOR_ADMIN_AUTH_TOKEN=generate-a-random-32-byte-hex-string-for-admin-scripts

# JWT Human User Authentication Settings
# Generate signing secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=generate-a-strong-random-64-character-hex-signing-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=store-share-coordinator
JWT_AUDIENCE=store-share-network

# Browser Session Security & Cookie Policies
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Allowed CORS Origins (Comma-separated trusted frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Initial Administrator Bootstrap Credentials (Used ONLY during initial setup)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@storeshare.net
INITIAL_ADMIN_PASSWORD=change-to-a-secure-master-password-min-8-chars

# Storage Node Discovery & Health Thresholds
HEARTBEAT_TIMEOUT_SECONDS=15
UNHEALTHY_THRESHOLD_SECONDS=45
DEAD_THRESHOLD_SECONDS=90
